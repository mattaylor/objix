{
  "name": "objix",
  "version": "2.3.1",
  "description": "A powerfull, high performance, lightweight library to inject many usefull methods into the Object prototype to simplify and sugar many common use cses.",
  "main": "objix.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:bun": "bun test",
    "perf": "node ./bench",
    "perf:bun": "bun ./bench.js",
    "mini": "terser objix.js --compress --output o.min.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattaylor/objix.git"
  },
  "author": "Mat Taylor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mattaylor/objix/issues"
  },
  "homepage": "https://objix.dev",
  "keywords": [
    "object",
    "prototype",
    "sugar",
    "delete",
    "flatMap",
    "iterator",
    "find",
    "pick",
    "map",
    "chain",
    "assign",
    "async",
    "promise",
    "extend",
    "keyBy",
    "bind",
    "json",
    "log",
    "class",
    "new",
    "diff",
    "clone",
    "equals",
    "trap",
    "observe",
    "memoize",
    "proxy",
    "eval"
  ],
  "devDependencies": {
    "@ungap/structured-clone": "^1.3.0",
    "hdr-histogram-js": "^3.0.1",
    "jest": "^30.4.2",
    "lodash": "^4.18.1",
    "reflect-metadata": "^0.2.2",
    "terser": "^5.50.0"
  }
}
